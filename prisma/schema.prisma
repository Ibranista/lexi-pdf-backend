generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ── IDENTITY & SYNC ──────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  name            String
  display_name    String?  @unique
  reading_level   String?
  email           String   @unique
  password        String
  role            String   @default("user")
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tokens           Token[]
  devices          Devices[]
  documents        Document[]
  collections      Collection[]
  reading_progress ReadingProgress[]
  focus_sessions   FocusSession[]
  highlights       Highlight[]
  notes            Note[]
  conversations    Conversation[]
  messages         Message[]
  review_cards     ReviewCard[]
  ai_jobs          AiJob[]
}

model Devices {
  device_id      String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String?
  platform       String?
  last_synced_at DateTime? @db.Timestamptz

  @@index([userId])
}

model Token {
  id          String   @id @default(uuid())
  token       String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  expires     DateTime
  blacklisted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([token])
}

// ── LIBRARY ──────────────────────────────────────────────────────

model Document {
  id              String   @id @default(uuid())
  owner_id        String
  owner           User     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  title           String
  author          String?
  storage_key     String
  page_count      Int
  file_size_bytes BigInt
  imported_at     DateTime @default(now()) @db.Timestamptz

  collection_documents CollectionDocument[]
  reading_progress     ReadingProgress[]
  focus_sessions       FocusSession[]
  highlights           Highlight[]
  notes                Note[]
  ai_summaries         AiSummary[]
  ai_explanations      AiExplanation[]
  conversations        Conversation[]
  review_cards         ReviewCard[]
  ai_jobs              AiJob[]
  document_chunks      DocumentChunk[]

  @@index([owner_id])
}

model Collection {
  id         String   @id @default(uuid())
  owner_id   String
  owner      User     @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  name       String
  color      String?
  sort_order Int
  created_at DateTime @default(now()) @db.Timestamptz

  collection_documents CollectionDocument[]

  @@index([owner_id])
}

model CollectionDocument {
  collection_id String
  collection    Collection @relation(fields: [collection_id], references: [id], onDelete: Cascade)
  document_id   String
  document      Document   @relation(fields: [document_id], references: [id], onDelete: Cascade)
  added_at      DateTime   @default(now()) @db.Timestamptz

  @@id([collection_id, document_id])
  @@index([document_id])
}

// ── READING ──────────────────────────────────────────────────────

model ReadingProgress {
  user_id         String
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  document_id     String
  document        Document @relation(fields: [document_id], references: [id], onDelete: Cascade)
  current_page    Int
  scroll_offset   Float
  context_snippet String? // powers Smart Return
  last_read_at    DateTime @default(now()) @db.Timestamptz

  @@id([user_id, document_id])
  @@index([document_id])
}

model FocusSession {
  id          String    @id @default(uuid())
  user_id     String
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  document_id String
  document    Document  @relation(fields: [document_id], references: [id], onDelete: Cascade)
  started_at  DateTime  @default(now()) @db.Timestamptz
  ended_at    DateTime? @db.Timestamptz
  pages_read  Int?

  @@index([user_id])
  @@index([document_id])
}

// ── ANNOTATIONS ──────────────────────────────────────────────────

model Highlight {
  id          String   @id @default(uuid())
  document_id String
  document    Document @relation(fields: [document_id], references: [id], onDelete: Cascade)
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  page_number Int
  color       String
  quoted_text String
  position    Json // jsonb text rects — survive re-render at any zoom
  created_at  DateTime @default(now()) @db.Timestamptz

  notes        Note[]
  review_cards ReviewCard[]

  @@index([document_id])
  @@index([user_id])
}

model Note {
  id           String     @id @default(uuid())
  document_id  String
  document     Document   @relation(fields: [document_id], references: [id], onDelete: Cascade)
  highlight_id String?
  highlight    Highlight? @relation(fields: [highlight_id], references: [id], onDelete: Cascade)
  user_id      String
  user         User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  page_number  Int
  body         String
  created_at   DateTime   @default(now()) @db.Timestamptz
  updated_at   DateTime   @updatedAt @db.Timestamptz

  @@index([document_id])
  @@index([highlight_id])
  @@index([user_id])
}

// ── AI COMPANION · PRO ───────────────────────────────────────────

model AiSummary {
  id          String   @id @default(uuid())
  document_id String
  document    Document @relation(fields: [document_id], references: [id], onDelete: Cascade)
  scope       String // page | chapter | doc
  page_from   Int?
  page_to     Int?
  content     String
  model       String?
  created_at  DateTime @default(now()) @db.Timestamptz

  @@index([document_id])
}

model AiExplanation {
  id            String   @id @default(uuid())
  document_id   String
  document      Document @relation(fields: [document_id], references: [id], onDelete: Cascade)
  page_number   Int
  source_text   String // selection
  explanation   String
  reading_level String?
  created_at    DateTime @default(now()) @db.Timestamptz

  @@index([document_id])
}

// ── ASK YOUR DOCUMENT · PRO ──────────────────────────────────────

model Conversation {
  id          String   @id @default(uuid())
  document_id String
  document    Document @relation(fields: [document_id], references: [id], onDelete: Cascade)
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title       String?
  created_at  DateTime @default(now()) @db.Timestamptz

  messages Message[]

  @@index([document_id])
  @@index([user_id])
}

// ── MESSAGES ─────────────────────────────────────────────────────

model Message {
  id              String       @id @default(uuid())
  conversation_id String
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user_id         String
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role            String // user | assistant
  content         String
  created_at      DateTime     @default(now()) @db.Timestamptz

  citations MessageCitation[]

  @@index([conversation_id])
  @@index([user_id])
}

model MessageCitation {
  id          String  @id @default(uuid())
  message_id  String
  message     Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  page_number Int // tap to jump
  quoted_text String

  @@index([message_id])
}

// ── REVIEW · PRO ─────────────────────────────────────────────────

model ReviewCard {
  id            String     @id @default(uuid())
  document_id   String
  document      Document   @relation(fields: [document_id], references: [id], onDelete: Cascade)
  highlight_id  String?
  highlight     Highlight? @relation(fields: [highlight_id], references: [id], onDelete: Cascade)
  user_id       String
  user          User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  front         String // prompt
  back          String // answer
  due_at        DateTime   @db.Timestamptz
  interval_days Int        @default(0) // SM-2
  ease_factor   Float      @default(2.5) // SM-2
  created_at    DateTime   @default(now()) @db.Timestamptz

  card_reviews CardReview[]

  @@index([document_id])
  @@index([highlight_id])
  @@index([user_id, due_at])
}

model CardReview {
  id          String     @id @default(uuid())
  card_id     String
  card        ReviewCard @relation(fields: [card_id], references: [id], onDelete: Cascade)
  reviewed_at DateTime   @default(now()) @db.Timestamptz
  rating      Int        @db.SmallInt // 0-3
  next_due_at DateTime   @db.Timestamptz

  @@index([card_id])
}

// ── AI BRIDGE · IN POSTGRES (OUTBOX) ─────────────────────────────

model AiJob {
  id          String    @id @default(uuid())
  user_id     String
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  document_id String
  document    Document  @relation(fields: [document_id], references: [id], onDelete: Cascade)
  kind        String // summarize | explain | ask | cards
  status      String    @default("queued") // queued | running | done | failed
  payload     Json? // request args
  result_id   String? // row created
  error       String?
  created_at  DateTime  @default(now()) @db.Timestamptz
  finished_at DateTime? @db.Timestamptz

  @@index([user_id])
  @@index([document_id])
  @@index([status])
}

// ── RAG ──────────────────────────────────────────────────────────

model DocumentChunk {
  id          String                       @id @default(uuid())
  document_id String
  document    Document                     @relation(fields: [document_id], references: [id], onDelete: Cascade)
  page_number Int // for citations
  content     String
  embedding   Unsupported("vector(1536)")? // pgvector
  token_count Int?

  @@index([document_id])
}
