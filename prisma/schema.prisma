generator client {
  // v7's `prisma-client` generator emits TypeScript, which this CommonJS
  // codebase would need a build step to consume. The classic generator still
  // ships in 7.x and still writes JavaScript into node_modules, so every
  // `require('@prisma/client')` here keeps working untouched.
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // The connection url lives in prisma.config.ts (Migrate) and is handed to
  // PrismaClient as a driver adapter at runtime — v7 takes neither here.
  extensions = [pgvector(map: "vector")]
}

// ── IDENTITY ─────────────────────────────────────────────────────
// Every install gets a real (anonymous) user row from the start, so
// highlights/notes/vocab work before there is an account and survive
// sign-in without a migration step. See spec §1.

model User {
  id String @id @default(uuid())

  name String @default("")
  // null for anonymous users — the API renders them as "". Postgres allows
  // many NULLs under a unique index, which is what makes this work.
  email           String? @unique
  password        String?
  googleId        String? @unique
  role            String  @default("user")
  isEmailVerified Boolean @default(false)
  isAnonymous     Boolean @default(false)

  // AI budget (spec §4). Counted per user, in requests, never per device.
  aiTier     String    @default("anonymous")
  aiUsed     Int       @default(0)
  aiResetsAt DateTime? @db.Timestamptz

  // Onboarding lives on the user row, not on the device, for the same reason
  // identity does: linking upgrades this row in place, so a reader who answered
  // the question anonymously is never asked it again after signing in, and a
  // second device inherits the answer the moment they sign in there.
  // `onboardedAt` is the merge tie-break — same last-write-wins rule as sync.
  hasCompletedOnboarding Boolean   @default(false)
  interests              String[]  @default([])
  onboardedAt            DateTime? @db.Timestamptz

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens      Token[]
  devices     Device[]
  documents   Document[]
  annotations Annotation[]
  vocab       VocabEntry[]
  chats       ChatSession[]
  indexes     DocumentIndex[]
  memory      UserMemory?
}

// A short, evolving note on how this reader likes to be talked to — their
// interests and the register/length of answer they engage with — distilled
// from their Lexi conversations and folded into the system prompt so replies
// adapt to them over time. One row per user; kept deliberately small.
model UserMemory {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  style     String   @default("") @db.Text
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model Device {
  // client-generated UUID v4 kept in expo-secure-store; not an OS identifier
  deviceId     String    @id
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     String?
  model        String?
  osVersion    String?
  appVersion   String?
  locale       String?
  lastSyncedAt DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model Token {
  id          String   @id @default(uuid())
  token       String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  expires     DateTime
  blacklisted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([token])
}

// ── SYNC ─────────────────────────────────────────────────────────
// Shapes mirror the client stores (spec §2.2). Two clocks on every row:
//   updatedAt       — the client's, the only input to last-write-wins
//   serverUpdatedAt — ours, the only input to the pull cursor
// Keeping them apart means a device with a skewed clock can lose a merge
// but can never make rows invisible to the other devices.

model Document {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  docKey              String
  uri                 String
  name                String
  ext                 String    @default("PDF")
  openedAt            DateTime  @db.Timestamptz
  page                Int       @default(0)
  pageCount           Int?
  bookmarks           Int[]     @default([])
  readingPlanMs       Int[]     @default([])
  readingTimeMsByPage Json?
  collections         String[]  @default([])
  updatedAt           DateTime  @db.Timestamptz
  deletedAt           DateTime? @db.Timestamptz

  serverUpdatedAt DateTime @updatedAt @db.Timestamptz
  lastDeviceId    String?

  @@unique([userId, docKey])
  @@index([userId, serverUpdatedAt])
}

model Annotation {
  // client-generated (`Date.now().toString(36)-seq`); accepted as given
  id        String    @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  docKey    String
  page      Int
  text      String
  // page text just before/after the passage as selected — picks the right
  // occurrence when `text` appears more than once on the page
  prefix    String?
  suffix    String?
  source    String?
  color     String
  note      String    @default("")
  createdAt DateTime  @db.Timestamptz
  updatedAt DateTime  @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  serverUpdatedAt DateTime @updatedAt @db.Timestamptz
  lastDeviceId    String?

  @@id([userId, id])
  @@index([userId, serverUpdatedAt])
  @@index([userId, docKey])
}

model VocabEntry {
  id        String    @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  docKey    String
  word      String
  pos       String?
  tr        String
  translit  String?
  lang      String
  p         Int?
  s1        String?
  s2        String?
  createdAt DateTime  @db.Timestamptz
  updatedAt DateTime  @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  serverUpdatedAt DateTime @updatedAt @db.Timestamptz
  lastDeviceId    String?

  @@id([userId, id])
  @@index([userId, serverUpdatedAt])
  @@index([userId, docKey])
}

// ── AI ───────────────────────────────────────────────────────────

model ChatSession {
  // client-generated per document and reused; scoped by user so one client
  // cannot read another's history by guessing a session id
  id        String   @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docKey    String
  title     String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  messages ChatMessage[]

  @@id([userId, id])
  @@index([userId, docKey])
}

model ChatMessage {
  id        String      @id @default(uuid())
  userId    String
  sessionId String
  session   ChatSession @relation(fields: [userId, sessionId], references: [userId, id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  kind      String? // normal | drift | recap
  page      Int?
  createdAt DateTime    @default(now()) @db.Timestamptz

  @@index([userId, sessionId, createdAt])
}

// Counts only — /ai/context is accepted and acknowledged but book text is
// not stored in v1 (spec §7.2). Swap `pagesIndexed` for real chunks when
// cross-chapter recall becomes the complaint.
model DocumentIndex {
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  docKey       String
  title        String?
  author       String?
  pageCount    Int?
  pagesIndexed Int      @default(0)
  // Whether this reads as fiction. Null until asked. Nothing is fact-checked
  // until this is false: a novel is not wrong when it says something untrue.
  fiction      Boolean?
  updatedAt    DateTime @updatedAt @db.Timestamptz

  @@id([userId, docKey])
}

/// One page's accuracy pass.
///
/// Deliberately not scoped to a user. `docKey` is derived from the document's
/// own bytes, so the same page of the same book is the same page for everyone —
/// and checking it is expensive enough that the second reader should not pay to
/// learn what the first already did. `textHash` keys the extraction, so a page
/// re-extracted differently is re-checked rather than answered from a stale row.
model PageCheck {
  docKey    String
  page      Int
  textHash  String
  /// FlaggedClaim[] as written by the model: quote, kind, note, confidence.
  claims    Json
  createdAt DateTime @default(now()) @db.Timestamptz

  @@id([docKey, page, textHash])
  @@index([docKey])
}
